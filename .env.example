# Public application origin used in development and secure email links.
APP_ORIGIN=http://localhost:8080

# Required before private platform routes or application persistence are enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campus_scouts

# Optional direct Neon connection URL for migrations and one-time administrator provisioning.
# Use DATABASE_URL (normally Neon pooled) for Vercel runtime queries.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/campus_scouts

# Generate and store only in the deployment secret manager; never commit a real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Configure a transactional email adapter for invitations and password reset links.
EMAIL_PROVIDER_API_KEY=replace-with-provider-key
EMAIL_FROM=Campus Scouts <no-reply@example.com>

# Private object storage; bucket contents must not be public by default.
OBJECT_STORAGE_ENDPOINT=https://storage.example.com
OBJECT_STORAGE_BUCKET=campus-scouts-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key

# Realtime service used only after persisted messages are written successfully.
REALTIME_SERVICE_URL=https://realtime.example.com
REALTIME_SERVICE_TOKEN=replace-with-token
