{
  "name": "campus-circle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/verify-invariants.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "cross-env NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "verify:a11y": "node scripts/verify-a11y.mjs",
    "verify:prod": "node scripts/verify-prod.mjs",
    "db:bootstrap": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^13.2.0",
    "ioredis": "^6.0.0",
    "next": "^15.1.6",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "msw": "^3.0.3",
    "playwright-core": "^1.63.0",
    "postcss": "^8",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
